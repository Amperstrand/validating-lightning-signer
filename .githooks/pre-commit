#!/bin/bash
# Pre-commit hook (documented install: ./scripts/enable-githooks).
# Composes BOTH checks (issue #21): the gitleaks staged secret scan
# (previously reachable only via hooks/pre-commit, which the documented
# setup never executed) and the nightly rustfmt check.
set -euo pipefail

# --- gitleaks staged secret scan -----------------------------------------
# gitleaks (optional but recommended): go install github.com/zricethezav/gitleaks/v8@v8.30.1
#   — same pinned version as CI; set GITLEAKS_REQUIRED=1 to fail-closed when absent.
# NOTE: if a .gitleaks.toml is ever added here, it MUST start with
#   [extend]\nuseDefault = true — otherwise it silently replaces the
#   entire default ruleset (org-sweep finding, 2026-10-07).
if command -v gitleaks >/dev/null 2>&1; then
    echo "gitleaks: scanning staged changes..."
    gitleaks protect --staged --redact --verbose
elif [ -n "${GITLEAKS_REQUIRED:-}" ]; then
    echo "gitleaks not found and GITLEAKS_REQUIRED is set" >&2
    echo "   install: go install github.com/zricethezav/gitleaks/v8@v8.30.1" >&2
    exit 1
else
    echo "gitleaks not installed — skipping staged secret scan"
    echo "   install: go install github.com/zricethezav/gitleaks/v8@v8.30.1"
fi

# --- formatting check -----------------------------------------------------
./scripts/fmt-all --check
