#!/usr/bin/env bash
# Kept for the `git config core.hooksPath hooks` install path. Both
# install paths must run the same checks, so this delegates to the
# composed .githooks/pre-commit (issue #21): gitleaks staged scan +
# nightly rustfmt check. The scan logic and its notes live there now.
exec "$(dirname "$0")/../.githooks/pre-commit" "$@"
